# Copie para .env e defina uma senha local antes de iniciar.
# O arquivo .env real nao deve ser enviado ao Git.
POSTGRES_DB=mercadinho
POSTGRES_USER=mercadinho
POSTGRES_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Porta da aplicacao quando executada com o perfil app do Docker Compose.
APP_PORT=8080
# No servidor HTTPS, altere para prod. Localmente, mantenha default.
SPRING_PROFILES_ACTIVE=default
